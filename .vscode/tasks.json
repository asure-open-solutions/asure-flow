{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: Install All Dependencies",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/setup.sh"],
      "windows": {
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/setup.ps1"]
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Server: Start",
      "type": "shell",
      "command": "${workspaceFolder}/server/.venv/bin/python",
      "args": [
        "-m", "uvicorn", "asure_flow.main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload",
        "--ws-max-size", "1048576"
      ],
      "windows": {
        "command": "${workspaceFolder}/server/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/server/src"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "asure-flow"
      }
    },
    {
      "label": "Server: Run Tests",
      "type": "shell",
      "command": "${workspaceFolder}/server/.venv/bin/python",
      "args": ["-m", "pytest", "tests/", "-v"],
      "windows": {
        "command": "${workspaceFolder}/server/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/server/src"
        }
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Server: Install Dependencies",
      "type": "shell",
      "command": "uv",
      "args": ["pip", "install", "-e", ".[dev]"],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Client: Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "asure-flow"
      }
    },
    {
      "label": "Client: Build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Client: Install Dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start All (Server + Client)",
      "dependsOn": ["Server: Start", "Client: Dev"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
