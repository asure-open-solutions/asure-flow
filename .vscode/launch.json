{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "asure_flow.main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload",
        "--ws-max-size", "1048576"
      ],
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/server/src"
      },
      "python": "${workspaceFolder}/server/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Client (Electron Dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/client",
      "console": "integratedTerminal"
    },
    {
      "name": "Server Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/server/src"
      },
      "python": "${workspaceFolder}/server/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Server + Client",
      "configurations": ["Server (FastAPI)", "Client (Electron Dev)"],
      "stopAll": true
    }
  ]
}
