# Asuré Flow Configuration
# Copy this file to .env and fill in your values

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Transcription ──
# Model: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# Device: cuda, cpu (auto-detected if not set)
# WHISPER_DEVICE=cuda
# Compute type: float16, int8, float32 (auto-selected based on device)
# WHISPER_COMPUTE_TYPE=float16
# Language: en, es, fr, etc. (auto-detected if not set)
# WHISPER_LANGUAGE=en

# ── LLM Providers (configure at least one) ──
# Providers are tried in order; first available wins.

# OpenRouter (recommended — access to many models via one key)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# HuggingFace Inference API
# HF_API_KEY=
# HF_MODEL=meta-llama/Llama-3.1-70B-Instruct

# GitHub Models
# GITHUB_TOKEN=
# GITHUB_MODEL=gpt-4o

# Custom OpenAI-compatible endpoint
# CUSTOM_API_KEY=
# CUSTOM_API_BASE=http://localhost:11434/v1
# CUSTOM_MODEL=local-model

# ── Session Storage ──
# SESSION_DIR=~/.asure-flow/sessions
