# Asuré Flow Configuration
# Copy this file to .env and fill in your values

# ── Server ──
# Localhost is the safe default. Set HOST=0.0.0.0 only for split server/client use
# on a trusted network; the API does not provide authentication.
HOST=127.0.0.1
PORT=8000

# ── Transcription ──
# Model: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# Profile: realtime, balanced, accurate
TRANSCRIPTION_PROFILE=balanced
# Set a known language (for example en) to avoid per-segment auto-detection
# WHISPER_LANGUAGE=en
# 0 uses the device default; 1 is fastest, 5 favors accuracy
# WHISPER_BEAM_SIZE=1
# Device: cuda, cpu (auto-detected if not set)
# WHISPER_DEVICE=cuda
# Compute type: float16, int8, float32 (auto-selected based on device)
# WHISPER_COMPUTE_TYPE=float16
# Language: en, es, fr, etc. (auto-detected if not set)
# WHISPER_LANGUAGE=en

# ── LLM Providers ──
# API keys set here are auto-applied to their matching default provider.
# Providers can also be added/removed/reordered via the Settings UI.
# At least one configured provider is required for AI features.

# OpenRouter (recommended — access to many models via one key)
# OPENROUTER_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# Groq
# GROQ_API_KEY=

# Custom OpenAI-compatible endpoint (Ollama, LM Studio, etc.)
# CUSTOM_API_KEY=
# CUSTOM_API_BASE=http://localhost:11434/v1

# ── Session Storage ──
# SESSION_DIR=~/.asure-flow/sessions
